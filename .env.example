# Keitaro tracker
KEITARO_URL=https://tlgk.host
# Create in Keitaro admin: Maintenance → Users → API keys (keep it out of git)
KEITARO_API_KEY=

# SQLite by default; PostgreSQL works too: postgresql+asyncpg://user:pass@host/db
# (docker compose runs PostgreSQL and sets this for you)
DATABASE_URL=sqlite+aiosqlite:///./keitaro_wrapper.db

# Every created campaign gets this prefix (task requirement: test_<surname>_)
CAMPAIGN_PREFIX=test_mkrtchyan_

# Preselected in the creator form, matched by name in Keitaro
DEFAULT_DOMAIN=in.posdk.xyz
DEFAULT_GROUP=FORTESTS
DEFAULT_TRAFFIC_SOURCE=FORTESTS

# Where the geo stream redirects
GEO_REDIRECT_URL=https://google.com

# --- Sign-in (all empty = open app, everyone may publish) ---
# One Basic-auth user (a publisher):
APP_USERNAME=admin
APP_PASSWORD=
# Several users with roles (editor = drafts only, publisher = may push to Keitaro):
# APP_USERS=alice:secret1:publisher,bob:secret2:editor
# SSO through a trusted reverse proxy such as oauth2-proxy (only if the app is
# reachable exclusively through it):
# TRUSTED_USER_HEADER=X-Forwarded-Email
# SSO_PUBLISHERS=lead@example.com

# --- Background sync with Keitaro, seconds (0 = off) ---
AUTO_SYNC_INTERVAL=300

# --- Stats ---
STATS_TIMEZONE=Europe/Moscow

# --- Observability ---
# text locally, json in production
LOG_FORMAT=text
LOG_LEVEL=INFO
SENTRY_DSN=
ENVIRONMENT=development
