# Keitaro tracker
KEITARO_URL=https://tlgk.host
# Create in Keitaro admin: Maintenance → Users → API keys (keep it out of git)
KEITARO_API_KEY=

# SQLite by default; PostgreSQL works too: postgresql+asyncpg://user:pass@host/db
# (docker compose runs PostgreSQL and sets this for you)
DATABASE_URL=sqlite+aiosqlite:///./keitaro_wrapper.db

# Every created campaign gets this prefix (task requirement: test_<surname>_)
CAMPAIGN_PREFIX=test_mkrtchyan_

# Preselected in the creator form, matched by name in Keitaro
DEFAULT_DOMAIN=in.posdk.xyz
DEFAULT_GROUP=FORTESTS
DEFAULT_TRAFFIC_SOURCE=FORTESTS

# Where the geo stream redirects
GEO_REDIRECT_URL=https://google.com

# Optional login for the wrapper itself (HTTP Basic). Leave the password empty to disable.
APP_USERNAME=admin
APP_PASSWORD=
